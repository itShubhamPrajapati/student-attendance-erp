# ==============================================================================
# QR-Based Student Attendance Management System - Frontend Environment Configuration
# ==============================================================================

# Production Backend API URL (Your deployed Render Go Web Service)
# Example: https://qr-attendance-api.onrender.com
VITE_BACKEND_URL=http://localhost:8080

# Production Public Frontend URL (Your Vercel App URL)
# Used for QR code link generation so mobile scanners open the production HTTPS URL
# Example: https://student-attendance-erp.vercel.app
VITE_APP_URL=http://localhost:5173
