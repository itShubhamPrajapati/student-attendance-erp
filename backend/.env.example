# ==============================================================================
# QR-Based Student Attendance Management System - Backend Environment Configuration
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=qr_attendance
DATABASE_SSLMODE=disable

# JWT Secret (Prepared for Phase 2 Authentication)
JWT_SECRET=change_this_to_a_secure_random_key_in_production
JWT_EXPIRATION_HOURS=24
