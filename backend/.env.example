# ==============================================================================
# QR-Based Student Attendance Management System - Backend Environment Configuration
# ==============================================================================

# Server Configuration
# PORT is automatically injected on Render/Heroku/Cloud platforms
PORT=8080
SERVER_PORT=8080
ENVIRONMENT=development
# Production: Set FRONTEND_URL to your Vercel deployment (e.g. https://student-attendance-erp.vercel.app)
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Production (Neon / Cloud PostgreSQL): Provide DATABASE_URL directly
# Example: postgres://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Local PostgreSQL Configuration (used if DATABASE_URL is empty)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=qr_attendance
DATABASE_SSLMODE=disable

# JWT Secret & Expiration
# Production: Generate a strong 256-bit random secret
JWT_SECRET=replace_with_secure_production_secret
JWT_EXPIRATION_HOURS=24

# Initial Admin Seed Credentials
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123
